<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="iiwa_camera" params="prefix">

    <link name="${prefix}iiwa_camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.03 0.03"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.03 0.03"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="${prefix}iiwa_camera_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}iiwa_camera_link"/>
      <origin xyz="0.0 0.0 0.08" rpy="0 1.5708 0"/>
    </joint>

    <gazebo reference="${prefix}iiwa_camera_link">
      <sensor name="iiwa_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/iiwa_camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
